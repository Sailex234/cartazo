NODE_ENV=development
PORT=4000
# Debe matchear POSTGRES_* y POSTGRES_PORT del .env de la raíz (docker-compose)
DATABASE_URL=postgresql://cartazo:cartazo@localhost:5436/cartazo
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=changeme
JWT_EXPIRES_IN=2h
# Credenciales de test de MercadoPago (dashboard.mercadopago.com.ar ->
# Tus integraciones -> credenciales de prueba). MP_ACCESS_TOKEN empieza con
# "TEST-". MP_WEBHOOK_SECRET es la "clave secreta" de la sección Webhooks de
# esa misma integración, usada para validar la firma de las notificaciones.
MP_ACCESS_TOKEN=TEST-changeme
MP_WEBHOOK_SECRET=changeme
# URL pública completa del webhook. En local, hasta tener un túnel (ngrok o
# similar) corriendo, dejar cualquier URL válida solo para que la API
# arranque -- el checkout funciona igual, MercadoPago simplemente no va a
# poder avisar el pago hasta que esto apunte a una URL real.
MP_NOTIFICATION_URL=http://localhost:4000/api/webhooks/mercadopago
